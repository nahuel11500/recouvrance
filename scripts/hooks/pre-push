#!/bin/bash
# Run before each push (git config core.hooksPath scripts/hooks): the quick checks CI fails on
# most, in seconds. Skip once with `git push --no-verify`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# What CI's "Format, spelling and licenses" job runs. Nothing here compiles.
cargo fmt --all --check
typos
cargo deny --log-level error check

# Clippy and the tests run in CI on the pull request (about four minutes), not here: on a
# machine shared by several agents a local clippy queues behind the others' builds.
