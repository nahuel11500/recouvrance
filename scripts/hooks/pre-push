#!/bin/bash
# Run before each push (git config core.hooksPath scripts/hooks): the checks CI fails on most,
# so a push doesn't wait for CI to learn about a lint. Skip once with `git push --no-verify`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# What CI's "Format, spelling and licenses" job runs. Nothing here compiles.
cargo fmt --all --check
typos
cargo deny --log-level error check

# Clippy, as CI's "Clippy and tests" job runs it. It builds in the main checkout's target dir,
# which every worktree shares, so dependencies are built once (AGENTS.md: never another target
# dir), with half the cores, and one at a time across worktrees: the lock waits for the others.
main="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)"
target="$main/target"
mkdir -p "$target"
exec 9>"$target/.pre-push.lock"
flock 9
export CARGO_TARGET_DIR="$target" CARGO_BUILD_JOBS=$(( $(nproc) / 2 ))
# Worktrees share that target dir, so a check can look fresh for code it never saw: touch the
# crate root so clippy always reads this checkout.
touch src/main.rs
cargo clippy --locked --all-targets --features dev -- -D warnings
cargo clippy --locked --all-targets -- -D warnings
